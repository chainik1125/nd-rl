#!/usr/bin/env bash
# Cron: enforce each run's budget. The DOLLAR budget is binding (Dan, 2026-10-19): warn the run at 80 % of USD,
# delete its pods at 100 %. Pod-hour ceilings are advice only: crossing one writes a note for the run, nothing
# more. A run with no USD budget falls back to enforcing its hour ceiling as before.
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"; . ~/.config/nd-rl/env 2>/dev/null
L=~/.config/nd-rl/limits; [ -d "$L" ] || exit 0
for f in "$L"/*; do
  [ -f "$f" ] || continue; RUN=$(basename "$f"); HOURS=""; USD=""; . "$f"; [ -n "${HOURS:-}${USD:-}" ] || continue
  set -- $(podbudget "$RUN" | awk '{print $3, $5}' | tr -d '$'); used=${1:-0}; dollars=${2:-0}
  live=$(grep -lx "RUN=$RUN" ~/.config/nd-rl/pods/* 2>/dev/null | wc -l); [ "$live" -gt 0 ] || continue
  if [ -n "${USD:-}" ]; then VAL=$dollars; LIMIT=$USD; WHAT="dollar budget (\$$dollars of \$$USD; $used pod-hours)"
  else VAL=$used; LIMIT=$HOURS; WHAT="pod-hour ceiling ($used of $HOURS h; \$$dollars)"; fi
  if awk -v u="$VAL" -v h="$LIMIT" 'BEGIN{exit !(u>=h)}'; then
    notify "$RUN: $WHAT reached" "Deleting this run's $live pod(s). Raising the budget is Dan's call (QUESTIONS.md)." high
    for p in $(grep -lx "RUN=$RUN" ~/.config/nd-rl/pods/* 2>/dev/null); do n=$(basename "$p")
      for path in artifacts numbers.md log.md STATUS.md; do timeout 600 podpull "$n" "$path" >/dev/null 2>&1 || true; done
      podrm "$n" >/dev/null 2>&1 || true; done
    echo "$(date -u +%FT%TZ) $RUN ENFORCED at $VAL/$LIMIT ($WHAT)" >> ~/podbudget.log
  elif awk -v u="$VAL" -v h="$LIMIT" 'BEGIN{exit !(u>=0.8*h)}'; then
    W=~/runs/$RUN/BUDGET_WARNING
    if [ ! -f "$W" ]; then
      mkdir -p ~/runs/$RUN; printf "%s has used 80 %% of its %s. Wrap up, or ask Dan in QUESTIONS.md.\n" "$RUN" "$WHAT" > "$W"
      # The warning is for the run (BUDGET_WARNING), not for Dan: he gets the 100 % enforcement message only (2026-09-30).
      echo "$(date -u +%FT%TZ) $RUN warned at $VAL/$LIMIT" >> ~/podbudget.log
    fi
  fi
  # With a dollar budget, the hour ceiling is advice: note the crossing once for the run; never delete pods for it.
  if [ -n "${USD:-}" ] && [ -n "${HOURS:-}" ] && awk -v u="$used" -v h="$HOURS" 'BEGIN{exit !(u>=h)}'; then
    A=~/runs/$RUN/HOURS_ADVISORY
    if [ ! -f "$A" ]; then
      mkdir -p ~/runs/$RUN
      printf "%s passed its advisory %s pod-hour ceiling (%s h, \$%s of \$%s). The dollar budget is the binding limit.\n" "$RUN" "$HOURS" "$used" "$dollars" "$USD" > "$A"
      echo "$(date -u +%FT%TZ) $RUN passed advisory hours $used/$HOURS" >> ~/podbudget.log
    fi
  fi
done
