#!/usr/bin/env bash
# Cron (hourly): warn before this host's disk fills. Twice a full disk has broken a run here (a
# worktree checkout on agent2, 2026-09-22; VPS1 at 96 % the same week). Notifies once per level
# crossed — 85 % (low priority) and 92 % (high) — with what worktree_gc says could be reclaimed, and
# adds a line to ~/ALERTS.md, which agents are told to read. Resets when usage falls back.
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"; . ~/.config/nd-rl/env 2>/dev/null
pct=$(df --output=pcent "$HOME" | tail -1 | tr -dc 0-9); avail=$(df -h --output=avail "$HOME" | tail -1 | tr -d ' ')
S=~/.disk_watch.level; last=$(cat "$S" 2>/dev/null || echo 0)
lvl=0; [ "$pct" -ge "${DISK_WARN_PCT:-85}" ] && lvl=1; [ "$pct" -ge "${DISK_HIGH_PCT:-92}" ] && lvl=2
if [ "$lvl" -gt "$last" ]; then
  safe=$(worktree_gc --brief 2>/dev/null | tr '\n' ',' | sed 's/,$//')
  msg="$avail free. Safe to remove (worktree_gc --delete): ${safe:-none}. Largest in ~/work: $(du -sh ~/work/*/ 2>/dev/null | sort -rh | head -3 | awk '{sub(/.*\/work\//,"",$2); printf "%s %s ", $2, $1}')"
  notify "$(hostname): disk ${pct}% used" "$msg" "$([ "$lvl" = 2 ] && echo high || echo low)"
  echo "$(date -u +%FT%TZ) DISK $(hostname) ${pct}% used, $avail free — write large outputs to the bucket, not local disk" >> ~/ALERTS.md
fi
echo "$lvl" > "$S"
