#!/usr/bin/env bash
# Create a pod from the nd-rl template, wait for SSH, register it.  Usage: podnew <name>
#   env: POD_GPU (default "NVIDIA A40"), POD_CLOUD (SECURE | COMMUNITY; default SECURE), POD_MINCUDA (13.0),
#        POD_EXTRA (further runpodctl flags), ND_RUN_ID (the run the pod belongs to).
# Every failure says why and leaves nothing unregistered behind (2026-09-28). Before: a failed create exited
# silently (`set -e` inside `$(…)`); a create whose --wait timed out left a live pod the watchdogs could not
# see; an SSH wait that timed out left a registered pod its caller believed had failed.
# RATE = the billed $/h RunPod reports for this pod (`costPerHr`); podrm and podbudget use it.
. ~/.config/nd-rl/env; export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
N=$1; [ -n "$N" ] || { echo "usage: podnew <name>"; exit 1; }
REG=~/.config/nd-rl/pods/$N; [ -f "$REG" ] && { echo "pod $N already registered"; exit 1; }
GPU=${POD_GPU:-NVIDIA A40}; ID=""
list() { runpodctl pod list 2>/dev/null | jq -c 'if type == "array" then . else empty end' 2>/dev/null; }
ids_named() { printf '%s' "$1" | jq -r --arg n "$N" '.[] | select(.name == $n) | .id' | sort; }
L0=$(list); BEFORE=""; [ -n "$L0" ] && BEFORE=$(ids_named "$L0")
undo() {   # remove pods named $N that this call created; never one that existed before it
  local L1 ids; L1=$(list)
  if [ -n "$L0" ] && [ -n "$L1" ]; then ids=$(comm -13 <(printf '%s\n' $BEFORE) <(ids_named "$L1"))
  else ids=$ID; fi   # the listing failed: touch only the id this call was given
  for id in $ids; do
    runpodctl pod remove "$id" >/dev/null 2>&1
    echo "podnew $N: removed half-created pod $id"
    echo "$(date -u +%FT%TZ) $N $id ${ND_RUN_ID:-unknown} UNDONE" >> ~/pods.log
  done
}
OUT=$(runpodctl pod create --name "$N" --template-id uhf9wr47j6 --gpu-id "$GPU" --cloud-type "${POD_CLOUD:-SECURE}" \
      --min-cuda-version "${POD_MINCUDA:-13.0}" ${POD_EXTRA} --wait --wait-timeout 12m 2>&1); RC=$?
ID=$(printf '%s' "$OUT" | grep -oE "pod [a-z0-9]{14}" | head -1 | cut -d" " -f2)
[ -n "$ID" ] || ID=$(printf '%s' "$OUT" | jq -r '.id // empty' 2>/dev/null)
if [ "$RC" -ne 0 ] || [ -z "$ID" ]; then
  echo "podnew $N: create failed (exit $RC): $(printf '%s' "$OUT" | tr '\n' ' ' | tail -c 600)"; undo; exit 1; fi
INFO=$(runpodctl ssh info "$ID" 2>&1)
IP=$(printf '%s' "$INFO" | jq -r '.ip // empty' 2>/dev/null); PORT=$(printf '%s' "$INFO" | jq -r '.port // empty' 2>/dev/null)
[ -n "$IP" ] && [ -n "$PORT" ] || { echo "podnew $N: no ssh address for $ID: $INFO"; undo; exit 1; }
RATE=$(list | jq -r --arg id "$ID" '.[] | select(.id == $id) | .costPerHr // empty' 2>/dev/null)
printf "POD_ID=%q\nPOD_IP=%q\nPOD_PORT=%q\nRUN=%q\nCREATED=%q\nGPU=%q\nRATE=%q\n" \
  "$ID" "$IP" "$PORT" "${ND_RUN_ID:-unknown}" "$(date -u +%FT%TZ)" "$GPU" "$RATE" > "$REG"
echo "$(date -u +%FT%TZ) $N $ID ${ND_RUN_ID:-unknown}" >> ~/pods.log
S="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=10 -p $PORT root@$IP"
end=$((SECONDS+600))
until $S true 2>/dev/null; do
  [ $SECONDS -ge $end ] && { echo "podnew $N: ssh never accepted the key ($ID); removing it"; podrm "$N"; exit 1; }
  sleep 10
done
podtoken "$N" >/dev/null 2>&1 || true
$S "mkdir -p /workspace/nd-takehome"
echo "pod $N ready: $ID $IP:$PORT (gpu $GPU, \$${RATE:-?}/h)"
