#!/usr/bin/env bash
# Pull one path from a pod.  Usage: podpull <pod> <relpath>   (into POD_LOCAL_ROOT, default ~/nd-takehome)
# rsync copies into the parent directory, so pulling a directory that already exists locally updates it
# instead of nesting it (the same bug `podpush` had).
. ~/.config/nd-rl/env; N=$1; shift; F=~/.config/nd-rl/pods/$N; [ -f "$F" ] || { echo "no pod $N (podls to list, podnew to create)"; exit 1; }; . "$F"; SSHO="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR -o ServerAliveInterval=30"
P=${1%/}; [ -n "$P" ] || { echo "usage: podpull <pod> <relpath>"; exit 1; }
L=${POD_LOCAL_ROOT:-$HOME/nd-takehome}; D=$(dirname "$P")
mkdir -p "$L/$D"
exec rsync -rlptz --no-o --no-g -e "ssh $SSHO -p $POD_PORT" "root@$POD_IP:/workspace/nd-takehome/$P" "$L/$D/"
