#!/usr/bin/env bash
# Delete a registered pod. Usage: podrm <name>
. ~/.config/nd-rl/env; export PATH="$HOME/.local/bin:$PATH"
N=$1; F=~/.config/nd-rl/pods/$N; [ -f "$F" ] || { echo "no pod $N"; exit 1; }; RATE=""; . "$F"
rate() { case "$1" in *A100*) echo 1.59;; *H100*) echo 3.49;; *A40*) echo 0.49;; *3090*) echo 0.50;; *4090*) echo 0.74;; *A6000*) echo 0.53;; *) echo 0.50;; esac; }
if [ -n "${CREATED:-}" ]; then
  H=$(awk -v a="$(date -u +%s)" -v b="$(date -u -d "$CREATED" +%s 2>/dev/null || date -u +%s)" 'BEGIN{printf "%.4f",(a-b)/3600}')
  D=$(awk -v h="$H" -v r="${RATE:-$(rate "${GPU:-}")}" 'BEGIN{printf "%.2f",h*r}')
  echo "$(date -u +%FT%TZ) ${RUN:-unknown} $N $H $D ${GPU:-}" >> ~/podhours.log
fi
OUT=$(runpodctl pod remove "$POD_ID" 2>&1); RC=$?
if [ $RC -ne 0 ] && ! printf "%s" "$OUT" | grep -qiE "not found|404"; then
  echo "podrm $N: delete failed, registry kept: $OUT"; exit 1
fi
rm -f "$F"
printf "%s" "$OUT" | grep -qiE "not found|404" && echo "removed $N ($POD_ID) [was already gone; registry cleaned]" || echo "removed $N ($POD_ID)${H:+ (${H}h, \$$D)}"
