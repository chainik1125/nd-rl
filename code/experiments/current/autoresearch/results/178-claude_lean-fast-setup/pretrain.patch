+def to_gpu(train_recs, tok, device):
+    """Tokenize all records and pad them once into (N, T) ids + proof mask on the device, plus
+    each record's largest N<k> index (for the shift augmentation) and length. The fork's
+    tokenizer is pure Python, ~15 s of the 300 s budget serially on the pod, so chunks of records
+    are encoded in forked worker processes and padded by one boolean scatter on the device."""
+    _RECS[:] = train_recs
+    bounds = [(lo, min(lo + 4096, len(train_recs))) for lo in range(0, len(train_recs), 4096)]
+    try:
+        with multiprocessing.get_context("fork").Pool(min(8, os.cpu_count() or 1)) as pool:
+            parts = pool.map_async(encode_range, bounds).get(timeout=60)
+    except Exception:  # no fork or a stuck worker: the same encoding, serially
+        parts = [encode_range(b) for b in bounds]
+    _RECS.clear()
+    flat, prompt_lens, proof_lens = (
+        torch.cat([torch.frombuffer(bytearray(part[k]), dtype=dtype) for part in parts])
+        .to(device)
