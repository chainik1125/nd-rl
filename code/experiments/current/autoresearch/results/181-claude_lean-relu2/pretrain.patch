+class ReLUSquared(torch.autograd.Function):
+    """Primer's squared ReLU (So et al. 2021), relu(x)^2, kept in the input dtype. `x ** 2` and
+    square() dispatch to pow, which autocast runs in fp32 (the likely cause of 076-claude's 24%
+    step-time loss); this saves only relu(x) and computes d/dx = 2 relu(x) directly."""
+
+    @staticmethod
+    def forward(ctx, x):
+        r = torch.relu(x)
+        ctx.save_for_backward(r)
+        return r * r
+
+    @staticmethod
+    def backward(ctx, *grad_outputs):
+        (r,) = ctx.saved_tensors
+        return (grad_outputs[0] * r).mul_(2)
+
+
+def relu_squared(x):
+    """ReLUSquared when training; in the sampler (no grad) two plain kernels, no Function call."""
+    if torch.is_grad_enabled():
+        return ReLUSquared.apply(x)
+    r = torch.relu(x)
+    return r.mul_(r)
+
