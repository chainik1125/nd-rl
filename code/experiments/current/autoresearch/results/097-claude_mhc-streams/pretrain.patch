+def sinkhorn(logits):
+    """Sinkhorn-Knopp projection of exp(logits) onto the doubly stochastic matrices."""
+    mix = logits.exp()
+    for _ in range(SINKHORN_ITERS):
+        mix = mix / mix.sum(1, keepdim=True)
+        mix = mix / mix.sum(0, keepdim=True)
+    return mix
+
+
+class HyperConnection(torch.nn.Module):
+    """Static manifold-constrained hyper-connection (mHC, DeepSeek-AI 2025) around one sublayer:
+    read a sigmoid-weighted mix of the residual streams, write the output back to every stream
+    with 2*sigmoid weights, and mix the streams through a doubly stochastic matrix. Starts
+    reading stream `index % N_STREAMS`, writing 1 to all, mixing ~identity, which on identical
+    streams is exactly the fork's residual block. Residual-stream arithmetic stays fp32."""
+
+    def __init__(self, index):
+        super().__init__()
+        self.read_logits = torch.nn.Parameter(torch.full((N_STREAMS,), -4.0))
+        self.read_logits.data[index % N_STREAMS] = 4.0
+        self.write_logits = torch.nn.Parameter(torch.zeros(N_STREAMS))
+        self.mix_logits = torch.nn.Parameter(4.0 * torch.eye(N_STREAMS))
+
+    def read(self, streams):  # (B, T, n, D) -> (B, T, D)
+        with torch.autocast(streams.device.type, enabled=False):
+            return torch.sigmoid(self.read_logits) @ streams
+
+    def write(self, streams, out):
+        with torch.autocast(streams.device.type, enabled=False):
+            written = 2 * torch.sigmoid(self.write_logits)[:, None] * out.float().unsqueeze(2)
+            return sinkhorn(self.mix_logits) @ streams + written
+
+
+class HyperGPT(GPT):
+    """The fork's GPT (same blocks, KV caches and signature) on N_STREAMS residual streams."""
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.hc = torch.nn.ModuleList(HyperConnection(i) for i in range(2 * len(self.blocks)))
+
+    def forward(self, idx, pos=None, mask=None, caches=None):
+        B, T = idx.shape
+        if pos is None:
+            cos, sin = rope_cache(T, self.hd, idx.device)
+        else:
+            cos_all, sin_all = rope_cache(int(pos.max().item()) + 1, self.hd, idx.device)
+            cos, sin = cos_all[pos], sin_all[pos]
+        streams = self.emb(idx).unsqueeze(2).expand(B, T, N_STREAMS, -1)
+        for i, b in enumerate(self.blocks):
+            attn_hc = cast(HyperConnection, self.hc[2 * i])
+            mlp_hc = cast(HyperConnection, self.hc[2 * i + 1])
+            cache = None if caches is None else caches[i]
+            y = b.attn(b.ln1(attn_hc.read(streams)), cos, sin, mask, cache)
+            streams = attn_hc.write(streams, y)
+            y = b.fc2(F.gelu(b.fc1(b.ln2(mlp_hc.read(streams)))))
+            streams = mlp_hc.write(streams, y)
+        return self.head(self.ln_f(streams.mean(2)))
+
