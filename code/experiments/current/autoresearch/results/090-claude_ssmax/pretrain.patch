+SSMAX_NREF = 64  # key count at which the Scalable-Softmax query multiplier starts at exactly 1
+
+
+class SSMaxGPT(GPT):
+    """The fork's GPT with Scalable-Softmax (Nakanishi 2025): each query is scaled by
+    s_h * log(n), n = the number of real keys it can see (position + 1), so attention does not
+    flatten as proofs grow past the <=6-line pretraining lengths. Stashes log(n) on the blocks."""
+
+    def forward(self, idx, pos=None, mask=None, caches=None):
+        T = idx.size(1)
+        n = torch.arange(1, T + 1, device=idx.device) if pos is None else pos + 1
+        logn = (n.float().log() / math.log(SSMAX_NREF)).view(-1, 1, T, 1)  # (1 or B, 1, T, 1)
+        for b in self.blocks:
+            b.logn = logn
+        return super().forward(idx, pos=pos, mask=mask, caches=caches)
+
+
+class SSMaxBlock(Block):
+    """The fork's Block, with q multiplied by exp(log_s) * log(n) / log(SSMAX_NREF) per head.
+    log_s starts at 0 and sits in AdamW, whose decay pulls it back toward that start."""
+
+    def attn(self, x, cos, sin, mask, cache):
+        B, T, D = x.shape
+        q, k, v = self.qkv(x).view(B, T, 3, self.h, D // self.h).permute(2, 0, 3, 1, 4)
+        q = q * (self.log_s.exp() * self.logn).type_as(q)
+        q, k = apply_rope(q, cos, sin), apply_rope(k, cos, sin)
+        if cache is not None:
+            # preallocated KV cache (avoids per-step torch.cat growth / allocator fragmentation)
+            if "k" not in cache:
+                cache["k"] = k.new_empty(B, self.h, cache["max"], D // self.h)
+                cache["v"] = v.new_empty(B, self.h, cache["max"], D // self.h)
+                cache["n"] = 0
+            n0, n1 = cache["n"], cache["n"] + T
+            cache["k"][:, :, n0:n1] = k
+            cache["v"][:, :, n0:n1] = v
+            cache["n"] = n1
+            k, v = cache["k"][:, :, :n1], cache["v"][:, :, :n1]
+            y = F.scaled_dot_product_attention(q, k, v, attn_mask=mask)
+        else:
+            y = F.scaled_dot_product_attention(q, k, v, attn_mask=mask, is_causal=mask is None)
+        return self.proj(y.transpose(1, 2).reshape(B, T, D))
 
 
