+                cache["k"] = k.new_empty(B, self.h, cache["max"], hd)
+                cache["v"] = v.new_empty(B, self.h, cache["max"], hd)
                 cache["n"] = 0
             n0, n1 = cache["n"], cache["n"] + T
             cache["k"][:, :, n0:n1] = k
