+        hd = D // self.h
+        q = self.q(x).view(B, T, self.h, hd).transpose(1, 2)
+        # Query heads [i * N_HEAD // N_KV, (i + 1) * N_HEAD // N_KV) read KV head i; the KV
+        # heads are expanded to N_HEAD here, on the T new tokens only, so the cache below stays
