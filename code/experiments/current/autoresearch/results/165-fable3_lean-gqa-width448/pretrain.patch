@@ -132,16 +138,28 @@ class PeriLNBlock(Block):
 
     def __init__(self, d, h):
         super().__init__(d, h)
+        # GQA: the fork's (3d, d) qkv becomes q (d, d) plus k and v of N_KV heads each; separate
+        # matrices so muon_step orthogonalizes the three roles separately, as before.
+        del self.qkv
+        self.q = torch.nn.Linear(d, d)
+        self.k = torch.nn.Linear(d, N_KV * (d // h))
