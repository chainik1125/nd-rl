+        k = self.k(x).view(B, T, N_KV, hd).transpose(1, 2).repeat_interleave(self.h // N_KV, 1)
+        v = self.v(x).view(B, T, N_KV, hd).transpose(1, 2).repeat_interleave(self.h // N_KV, 1)
