+def masked_ce(logits, tgt, mk):
+    """The fork's loss_on reduction: mean cross-entropy over proof-token targets."""
+    ce = F.cross_entropy(
+        logits.reshape(-1, logits.size(-1)).float(), tgt.reshape(-1), reduction="none"
+    )
+    return (ce * mk.reshape(-1)).sum() / mk.sum()
+
+
+def mtp_losses(model, mtp, x, m):
+    """(next-token loss, identical to the fork's loss_on; depth-1 MTP loss). As in DeepSeek-V3,
+    position t projects [norm(final hidden h_t); norm(Emb(x[t+1]))] through one extra block and
+    the shared readout to predict x[t+2]."""
+    inp = x[:, :-1]
+    cos, sin = rope_cache(inp.size(1), model.hd, x.device)
+    h = model.emb(inp)
+    for b in model.blocks:
+        h = b(h, cos, sin)
+    main = masked_ce(model.head(model.ln_f(h)), x[:, 1:], m[:, 1:])
+    z = mtp.proj(torch.cat([mtp.hnorm(h[:, :-1]), mtp.enorm(model.emb(x[:, 1:-1]))], -1))
+    z = mtp.block(z, cos[:-1], sin[:-1])
+    return main, masked_ce(model.head(mtp.norm(z)), x[:, 2:], m[:, 2:])
+
