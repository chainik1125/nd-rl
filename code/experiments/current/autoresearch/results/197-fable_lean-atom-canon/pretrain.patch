+    def rename_in(self, idx, state=None):
+        """(ids with every atom replaced by its order of first appearance, (B, T, N_ATOM) index
+        of each atom's logit at each position). Causal: position t uses tokens <= t only.
+        `state` (caches[0]) carries the map across the calls of incremental decoding."""
+        a = idx - ATOM0
+        is_atom = (a >= 0) & (a < N_ATOM)
+        a = a.clamp(0, N_ATOM - 1)
+        n_before = 0 if state is None else state["n_atoms"][:, None]
+        body = is_atom & (is_atom.cumsum(1) + n_before > N_ATOM)  # not the header
+        hit = torch.nn.functional.one_hot(a, N_ATOM).bool() & body[..., None]
+        old = hit.new_zeros(idx.size(0), N_ATOM) if state is None else state["seen"]
+        seen = (hit.cumsum(1) > 0) | old[:, None]  # (B, T, N_ATOM): appeared at or before t
+        first = (~seen).sum(1)  # position of each atom's first appearance in this chunk
+        earlier = (first[:, :, None] > first[:, None, :]) & ~old[:, None, :]
+        rank = old.sum(1, keepdim=True) + earlier.sum(-1)
+        if state is not None:
+            rank = torch.where(old, state["rank"], rank)
+            state["n_atoms"] = state["n_atoms"] + is_atom.sum(1)
+            state["seen"], state["rank"] = seen[:, -1], rank
