+        ]:
+            p.mul_(RESID_SCALE)
+        for m in model.modules():
+            if isinstance(m, torch.nn.LayerNorm):
+                m.eps *= RESID_SCALE**2
+        drift = (model(probe).float() - before).abs().max().item()
+    log(f"handoff: residual writes and LayerNorm eps scaled, max |logit drift| {drift:.2e}")
     return (
