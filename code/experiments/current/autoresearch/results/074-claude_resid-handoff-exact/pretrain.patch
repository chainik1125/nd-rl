     model.eval()
+    # Every residual write (emb, proj, fc2) is read back only through a LayerNorm, and
+    # LN(s * x; s^2 * eps) == LN(x; eps), so scaling the writes by s and every eps by s^2 leaves
+    # the function exactly unchanged, while the frozen RL AdamW's roughly fixed-size steps move
+    # these weights 1/s times further relative to their size.
+    with torch.no_grad():
+        probe = ids[:BS, : int(lens[:BS].max())]
+        before = model(probe).float()
+        for p in [model.emb.weight] + [
