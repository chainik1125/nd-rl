+# Initial learned per-head gain on RMS-normalized queries: max |logit| = QK_GAIN * sqrt(head_dim).
+QK_GAIN = 2.0
 TOK_MODE = "abs"
 VAL_N, CURVE_EVERY = 1024, 15  # records held out for val_loss; seconds between curve points
 
 
+def rms(x):
+    """RMS-normalize over the head dimension in fp32, without a learned weight."""
+    x = x.float()
+    return x * torch.rsqrt(x.square().mean(-1, keepdim=True) + 1e-6)
+
+
+class QKNormBlock(Block):
+    """P35: the fork's Block with q and k RMS-normalized per head and a learned gain per head."""
+
+    def attn(self, x, cos, sin, mask, cache):
+        B, T, D = x.shape
+        q, k, v = self.qkv(x).view(B, T, 3, self.h, D // self.h).permute(2, 0, 3, 1, 4)
+        q, k = (rms(q) * self.q_gain).type_as(v), rms(k).type_as(v)
+        q, k = apply_rope(q, cos, sin), apply_rope(k, cos, sin)
+        if cache is not None:
+            # preallocated KV cache (avoids per-step torch.cat growth / allocator fragmentation)
+            if "k" not in cache:
+                cache["k"] = k.new_empty(B, self.h, cache["max"], D // self.h)
+                cache["v"] = v.new_empty(B, self.h, cache["max"], D // self.h)
+                cache["n"] = 0
+            n0, n1 = cache["n"], cache["n"] + T
+            cache["k"][:, :, n0:n1] = k
+            cache["v"][:, :, n0:n1] = v
+            cache["n"] = n1
+            k, v = cache["k"][:, :, :n1], cache["v"][:, :, :n1]
+            y = F.scaled_dot_product_attention(q, k, v, attn_mask=mask)
+        else:
+            y = F.scaled_dot_product_attention(q, k, v, attn_mask=mask, is_causal=mask is None)
+        return self.proj(y.transpose(1, 2).reshape(B, T, D))
+
