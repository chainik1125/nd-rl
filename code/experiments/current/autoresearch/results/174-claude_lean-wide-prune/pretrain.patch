+@torch.no_grad()
+def prune_mlps(model, x, width, matrices, buffers, opt):
+    """Keep each trunk MLP's `width` most important hidden units: RMS GELU activation on the
+    training batch x times the unit's fc2 column norm, i.e. the size of what removing it would
+    subtract from the branch output. Muon momentum and the fc1 bias's AdamW moments are sliced
+    to match, so the optimizer carries on as if the removed units had never existed."""
+    acts = []
+    hooks = [b.fc1.register_forward_hook(lambda _m, _i, a: acts.append(a)) for b in model.blocks]
+    model.features(x)
+    for hook in hooks:
+        hook.remove()
+    slot = {id(p): i for i, p in enumerate(matrices)}
+    for b, a in zip(model.blocks, acts, strict=True):
+        act_rms = torch.nn.functional.gelu(a.float()).square().mean((0, 1)).sqrt()
+        keep = (act_rms * b.fc2.weight.float().norm(dim=0)).topk(width).indices.sort().values
+        for p, dim in ((b.fc1.weight, 0), (b.fc2.weight, 1)):
+            p.data = p.data.index_select(dim, keep)
+            buffers[slot[id(p)]] = buffers[slot[id(p)]].index_select(dim, keep)
+        b.fc1.bias.data = b.fc1.bias.data[keep]
+        state = opt.state[b.fc1.bias]
+        for k in ("exp_avg", "exp_avg_sq"):
+            state[k] = state[k][keep]
+        b.fc1.out_features = b.fc2.in_features = width
+
