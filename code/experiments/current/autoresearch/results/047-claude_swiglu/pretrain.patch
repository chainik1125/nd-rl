+class SwiGLUBlock(Block):
+    """The fork's Block with a SwiGLU MLP (Shazeer 2020): fc2(silu(gate(h)) * fc1(h))."""
+
+    def __init__(self, d, h):
+        super().__init__(d, h)
+        self.gate, self.fc1, self.fc2 = (
+            torch.nn.Linear(d, FF),
+            torch.nn.Linear(d, FF),
+            torch.nn.Linear(FF, d),
+        )
+
+    def forward(self, x, cos, sin, mask=None, cache=None):
+        x = x + self.attn(self.ln1(x), cos, sin, mask, cache)
+        h = self.ln2(x)
+        return x + self.fc2(F.silu(self.gate(h)) * self.fc1(h))
+
