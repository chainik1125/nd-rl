+def train_loss(model, x, m, tok):
+    """loss_on's proof-token loss plus PROMPT_LOSS_W times the loss on prompt tokens of the same
+    records, normalized by proof tokens. Returns (objective, proof-only loss for logging)."""
+    logits = model(x[:, :-1])
+    tgt = x[:, 1:]
+    ce = F.cross_entropy(
+        logits.reshape(-1, logits.size(-1)).float(), tgt.reshape(-1), reduction="none"
+    )
+    proof = m[:, 1:].reshape(-1).float()
+    prompt = ((tgt != tok.pad) & ~m[:, 1:]).reshape(-1).float()
+    proof_loss = (ce * proof).sum() / proof.sum()
+    return proof_loss + PROMPT_LOSS_W * (ce * prompt).sum() / proof.sum(), proof_loss.detach()
+
