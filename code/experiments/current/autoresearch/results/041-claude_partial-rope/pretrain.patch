+# Rotate only the 8 highest-frequency of each head's 16 RoPE pairs (wavelengths <= 353 tokens).
+# The other 8 (wavelengths >= 628) never complete a turn within the longest pretraining record
+# (516 tokens), so they are left unrotated: content-only channels at any distance.
+ROPE_PAIRS = 8
 TOK_MODE = "abs"
 VAL_N, CURVE_EVERY = 1024, 15  # records held out for val_loss; seconds between curve points
 
 
+class PartialRopeGPT(GPT):
+    """Fork GPT forward with cos=1, sin=0 on rotary pairs >= ROPE_PAIRS; kept through RL."""
+
+    def forward(self, idx, pos=None, mask=None, caches=None):
+        T = idx.shape[1] if pos is None else int(pos.max().item()) + 1
+        cos, sin = rope_cache(T, self.hd, idx.device)
+        cos[:, ROPE_PAIRS:], sin[:, ROPE_PAIRS:] = 1.0, 0.0
+        if pos is not None:
+            cos, sin = cos[pos], sin[pos]
+        x = self.emb(idx)
+        for i, block in enumerate(self.blocks):
+            x = block(x, cos, sin, mask, None if caches is None else caches[i])
+        return self.head(self.ln_f(x))
+
