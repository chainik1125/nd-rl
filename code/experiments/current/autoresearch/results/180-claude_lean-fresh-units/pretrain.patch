 # the model's own ln_f/head. Its loss is added at this weight (DeepSeek-V3's early-training value).
 MTP_WEIGHT = 0.3
+# Plasticity injection (Nikishin et al. 2023) at handoff: every trunk MLP gets this many fresh
+# units for RL to train, fc1 rows random at the trained fc1's element scale and fc2 columns zero,
+# so the handed-off function is unchanged. 6 x 88 x (384 + 1 + 384) = 406,032 params fill the cap
+# (9,963,792 of 10M); pretraining is untouched.
+D_FF_FRESH = 88
 
 
 # Muon update adapted from KellerJordan/Muon, commit
@@ -226,6 +231,21 @@ def mtp_loss(model, mtp, x, m):
     return main + MTP_WEIGHT * aux, main, aux
 
 
+@torch.no_grad()
+def inject_fresh_units(block, n_new, gen):
+    """Widen block's MLP by n_new units that write nothing yet (zero fc2 columns)."""
+    fc1, fc2 = block.fc1, block.fc2
+    h, device = fc1.out_features, fc1.weight.device
+    new1 = torch.nn.Linear(fc1.in_features, h + n_new).to(device)
+    new2 = torch.nn.Linear(h + n_new, fc2.out_features).to(device)
+    new1.weight[:h], new1.bias[:h], new1.bias[h:] = fc1.weight, fc1.bias, 0.0
+    new1.weight[h:] = fc1.weight.std() * torch.randn(
+        n_new, fc1.in_features, device=device, generator=gen
+    )
+    new2.weight[:, :h], new2.weight[:, h:], new2.bias[:] = fc2.weight, 0.0, fc2.bias
+    block.fc1, block.fc2 = new1, new2
+
