+def pretrain_loss(model, x, mask):
+    """P49: penalize log-partition only during pretraining, on the same proof tokens."""
+    logits = model(x[:, :-1]).float()
+    supervised = mask[:, 1:].reshape(-1)
+    token_loss = F.cross_entropy(
+        logits.reshape(-1, logits.size(-1)), x[:, 1:].reshape(-1), reduction="none"
+    )
+    log_partition = logits.logsumexp(dim=-1).reshape(-1)
+    return ((token_loss + Z_LOSS * log_partition.square()) * supervised).sum() / supervised.sum()
 
 
