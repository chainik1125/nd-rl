+    def forward(self, idx, pos=None, mask=None, caches=None):
+        if pos is None:
+            cos, sin = rope_cache(idx.shape[1], self.hd, idx.device, base=ROPE_BASE)
+        else:
+            cos_all, sin_all = rope_cache(
+                int(pos.max().item()) + 1, self.hd, idx.device, base=ROPE_BASE
+            )
+            cos, sin = cos_all[pos], sin_all[pos]
+        x = self.emb(idx)
+        for i, block in enumerate(self.blocks):
+            x = block(x, cos, sin, mask, None if caches is None else caches[i])
+        return self.head(self.ln_f(x))
+
