+class TopMLP(torch.nn.Module):
+    """A pre-norm MLP sublayer with no attention, run after the last Block. It lives in
+    model.blocks so the fork's GPT.forward calls it; it ignores rope, mask and its KV cache."""
+
+    def __init__(self, d):
+        super().__init__()
+        self.ln = torch.nn.LayerNorm(d)
+        self.fc1 = torch.nn.Linear(d, 4 * d)
+        self.fc2 = torch.nn.Linear(4 * d, d)
+
+    def forward(self, x, cos, sin, mask=None, cache=None):
+        return x + self.fc2(F.gelu(self.fc1(self.ln(x))))
+
