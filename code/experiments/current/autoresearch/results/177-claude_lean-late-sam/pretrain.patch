+def sam_grads(model, mtp, x, m, params, autocast):
+    """SAM ascent: given .grad from the pass at w, overwrite it with the gradient of the same
+    batch at w + SAM_RHO * g / ||g||, then restore w exactly. Returns the perturbed main loss."""
+    live = [p for p in params if p.grad is not None]
+    with torch.no_grad():
+        norm = torch.stack([p.grad.norm() for p in live]).norm()
+        backup = [p.detach().clone() for p in live]
+        for p in live:
+            p.add_(p.grad * (SAM_RHO / (norm + 1e-12)))
+    model.zero_grad(set_to_none=True)
+    mtp.zero_grad(set_to_none=True)
+    with autocast:
+        loss, main, _ = mtp_loss(model, mtp, x, m)
+    loss.backward()
+    with torch.no_grad():
+        for p, b in zip(live, backup, strict=True):
+            p.copy_(b)
+    return main
+
