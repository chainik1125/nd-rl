+    def span_codes(self, idx, cache):
+        """(B, T, SPAN_BITS): at every ')' the +-1 bits (scaled to unit norm) of the hash of the
+        tokens from its matching '(' to itself, zeros elsewhere. The hash of span [i, j] is
+        sum_k (token_k + 1) R^(k - i) mod P, taken from prefix sums, so it depends on the span's
+        content only. `cache` (caches[0]) carries the prefix hash, the depth and the open
+        bracket of every level across calls, so cached decoding sees the full forward's codes."""
+        B, T = idx.shape
+        hash_pow, hash_inv = (self.hash_pow, self.hash_inv) if idx.is_cuda else self.hash_cpu
+        opens, closes = idx == OPEN, idx == CLOSE
+        if cache is not None and "span_n" in cache:
+            n0, depth0, hash0 = cache["span_n"], cache["span_depth"], cache["span_hash"]
+            open_i0, open_h0 = cache["span_open_i"], cache["span_open_h"]
+        else:
+            n0, depth0, hash0 = 0, idx.new_zeros(B), idx.new_zeros(B)
+            open_i0 = idx.new_full((B, SPAN_DEPTH), -1)
+            open_h0 = idx.new_zeros(B, SPAN_DEPTH)
+        k = n0 + torch.arange(T, device=idx.device)
+        term = (idx + 1) * hash_pow[k] % HASH_P
+        prefix = (hash0[:, None] + term.cumsum(1)) % HASH_P  # hash of tokens [0, k]
+        before = (prefix - term) % HASH_P  # hash of tokens [0, k)
+        depth = depth0[:, None] + (opens.long() - closes.long()).cumsum(1)
+        level = (depth + closes.long()).clamp(0, SPAN_DEPTH - 1)  # of the bracket at k
+        at_level = level[..., None] == torch.arange(SPAN_DEPTH, device=idx.device)
+        # Index of the latest '(' of every level up to k (-1: none); earlier calls via the cache.
+        open_i = torch.where(opens[..., None] & at_level, k[None, :, None], -1).cummax(1).values
+        open_i = torch.maximum(open_i, open_i0[:, None])
+        start_i = open_i.gather(2, level[..., None]).squeeze(-1)  # (B, T): the matching '('
+        start_h = torch.where(
+            start_i >= n0, before.gather(1, (start_i - n0).clamp(min=0)), open_h0.gather(1, level)
+        )
+        code = (prefix - start_h) % HASH_P * hash_inv[start_i.clamp(min=0)] % HASH_P
+        if cache is not None:
+            last = open_i[:, -1]
+            cache["span_open_h"] = torch.where(
+                last >= n0, before.gather(1, (last - n0).clamp(min=0)), open_h0
+            )
+            cache["span_open_i"], cache["span_n"] = last, n0 + T
+            cache["span_depth"], cache["span_hash"] = depth[:, -1], prefix[:, -1]
+        bits = (code[..., None] >> torch.arange(SPAN_BITS, device=idx.device)) & 1
+        return (2.0 * bits - 1) * (closes & (start_i >= 0))[..., None] / SPAN_BITS**0.5
+
