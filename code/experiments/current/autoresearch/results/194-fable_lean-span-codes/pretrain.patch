+# bits of a polynomial rolling hash of the span's tokens, mod the Mersenne prime 2^31 - 1), so
+# two occurrences of the same sub-formula anywhere in the context get the same input feature
+# and a content head can match them in one hop, however long the formula is.
+OPEN, CLOSE = 2, 3  # lean_seq ids of '(' and ')' (checked in pretrain())
+SPAN_BITS, SPAN_DEPTH = 31, 32  # code width; nesting levels tracked (deeper ones share the last)
+HASH_P, HASH_R, HASH_LEN = 2**31 - 1, 1_000_003, 4096  # modulus, base, positions with a power
 
 
