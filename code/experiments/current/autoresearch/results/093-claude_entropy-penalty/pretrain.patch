 VAL_N, CURVE_EVERY = 1024, 15  # records held out for val_loss; seconds between curve points
+ENTROPY_PENALTY = 0.05
+
+
+def pretrain_loss(model, x, mask):
+    """P48 reversed: penalize predictive entropy on the supervised proof tokens (sharpening)."""
+    log_probs = model(x[:, :-1]).float().log_softmax(dim=-1)
+    token_loss = -log_probs.gather(-1, x[:, 1:, None]).squeeze(-1)
+    entropy = -(log_probs.exp() * log_probs).sum(dim=-1)
+    supervised = mask[:, 1:]
+    return ((token_loss + ENTROPY_PENALTY * entropy) * supervised).sum() / supervised.sum()
 
 
