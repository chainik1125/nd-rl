+class UNetGPT(GPT):
+    """U-net skips as in modded-nanogpt: the outputs of the first N_LAYER // 2 blocks are added,
+    in reverse order and scaled by learned scalars (init 1), to the inputs of the last ones.
+    forward is the fork's GPT.forward plus the skips; same pos/mask/caches handling."""
+
+    def __init__(self, vocab, n_layer, d, n_head):
+        super().__init__(vocab, n_layer, d, n_head)
+        self.skip_weights = torch.nn.Parameter(torch.ones(n_layer // 2))
+
+    def forward(self, idx, pos=None, mask=None, caches=None):
+        T = idx.shape[1]
+        if pos is None:
+            cos, sin = rope_cache(T, self.hd, idx.device)
+        else:
+            cos_all, sin_all = rope_cache(int(pos.max().item()) + 1, self.hd, idx.device)
+            cos, sin = cos_all[pos], sin_all[pos]
+        x, skips, n = self.emb(idx), [], len(self.skip_weights)
+        for i, b in enumerate(self.blocks):
+            if i >= n:
+                x = x + self.skip_weights[i - n] * skips.pop()
+            x = b(x, cos, sin, mask, None if caches is None else caches[i])
+            if i < n:
+                skips.append(x)
+        return self.head(self.ln_f(x))
+
+
