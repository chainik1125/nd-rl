+def first_fit(lengths, cap):
+    """First-fit decreasing: a (row, offset) slot per record so rows of `cap` tokens hold whole
+    records, plus the number of rows."""
+    rows, offsets, free = [0] * len(lengths), [0] * len(lengths), []
+    for j in sorted(range(len(lengths)), key=lengths.__getitem__, reverse=True):
+        r = next((r for r, f in enumerate(free) if f >= lengths[j]), len(free))
+        if r == len(free):
+            free.append(cap)
+        rows[j], offsets[j] = r, cap - free[r]
+        free[r] -= lengths[j]
+    return rows, offsets, len(free)
+
+
+def pack_batch(x, m, n, pad):
+    """Layout only: move gpu_batch's B right-padded records (lengths n) into R ~ B/2 rows and
+    return the packed ids, proof mask and an (R, 1, C, C) mask letting each token see only
+    earlier tokens of its own record. ALiBi depends on i - j only and the NoPE heads on nothing,
+    so every record gets the logits and loss terms it gets alone in a padded row. C - 1, the
+    attention length, is a multiple of 16 so SDPA's memory-efficient kernel takes the bias
+    without its pad-and-copy."""
+    B, T = x.shape
+    C = 16 * math.ceil((T - 1) / 16) + 1
+    rows, offsets, R = first_fit(n, C)
+    n_t = torch.tensor(n)
+    rec = torch.repeat_interleave(torch.arange(B), n_t)
+    t = torch.arange(len(rec)) - torch.repeat_interleave(n_t.cumsum(0) - n_t, n_t)
+    dst = torch.tensor(rows)[rec] * C + torch.tensor(offsets)[rec] + t
+    src, dst, rec = torch.stack((rec * T + t, dst, rec)).to(x.device)
+    xp = x.new_full((R * C,), pad)
+    xp[dst] = x.reshape(-1)[src]
+    mp = m.new_zeros(R * C)
+    mp[dst] = m.reshape(-1)[src]
+    seg = rec.new_full((R * C,), -1)  # record index per slot; padding slots see only padding
+    seg[dst] = rec
+    seg = seg.view(R, C)
+    causal = torch.ones(C, C, dtype=torch.bool, device=x.device).tril()
+    return xp.view(R, C), mp.view(R, C), ((seg[:, :, None] == seg[:, None, :]) & causal)[:, None]
+
