+    def out_of_scope(self, idx):
+        """(B, T, T) bool: key s is inside a `( fun ... )` box that closed at or before query t.
+        Causal: row t depends on tokens <= t only. A query always sees itself."""
+        T = idx.size(1)
+        is_open = idx == LP
+        depth = (is_open.int() - (idx == RP).int()).cumsum(1)  # after each token
+        box = is_open & torch.nn.functional.pad(idx[:, 1:] == FUN, (0, 1))
+        ar = torch.arange(T, device=idx.device)
+        after = ar[None, :] > ar[:, None]  # (p, q): q is after p
+        # close[p]: the first q > p whose depth is below depth[p], i.e. the matching `)`
+        lower = (depth[:, None, :] < depth[:, :, None]) & after
+        close = torch.where(lower.any(-1), lower.int().argmax(-1), T)
+        inside = box[:, :, None] & after & (ar < close[:, :, None])  # (B, p, s)
+        hide_at = torch.where(inside, close[:, :, None], T).amin(1)  # innermost box closes first
+        return ar[None, :, None] >= hide_at[:, None, :]
+
+    def out_of_scope_step(self, idx, c, n0):
+        """out_of_scope for incremental decoding: (B, T, n0 + T) for the T new tokens at cache
+        positions n0.., with the bracket state of every row kept in `c` (caches[0])."""
+        B, T = idx.shape
+        if "hidden" not in c:
+            c["depth"] = idx.new_zeros(B)
+            c["open"] = idx.new_full((B, c["max"]), -(10**6))  # depth after each `(`
+            c["box"] = torch.zeros(B, c["max"], dtype=torch.bool, device=idx.device)
+            c["hidden"], c["prev_open"] = torch.zeros_like(c["box"]), c["box"][:, 0].clone()
+        ar = torch.arange(c["max"], device=idx.device)
+        rows = []
+        for j in range(T):
+            x, n = idx[:, j], n0 + j
+            if n > 0:
+                c["box"][:, n - 1] = c["prev_open"] & (x == FUN)
+            # `)` matches the last `(` opened at the current depth; a box's inside gets hidden
+            opened = c["open"] == c["depth"][:, None]
+            match = (opened * ar).amax(1, keepdim=True)
+            closes = (x == RP) & opened.any(1) & c["box"].gather(1, match).squeeze(1)
+            c["hidden"] |= closes[:, None] & (ar > match) & (ar < n)
+            c["prev_open"] = x == LP
+            c["depth"] = c["depth"] + c["prev_open"].long() - (x == RP).long()
+            c["open"][:, n] = torch.where(c["prev_open"], c["depth"], -(10**6))
+            rows.append(c["hidden"][:, : n0 + T].clone())
+        return torch.stack(rows, 1)
+
