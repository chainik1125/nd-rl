+def grow(model, opt, matrices, momentum_buffers):
+    """G_stack: append a trained copy of every block (A-B-C -> A-B-C-A-B-C). The copies' matrices
+    join Muon with fresh momentum; their LayerNorm gains and biases join AdamW as a new group."""
+    new_blocks = [copy.deepcopy(b) for b in model.blocks]
+    model.blocks.extend(new_blocks)
+    model.cfg["n_layer"] = len(model.blocks)
+    new_params = [p for b in new_blocks for p in b.parameters()]
+    new_matrices = [p for p in new_params if p.ndim == 2]
+    matrices += new_matrices
+    momentum_buffers += [torch.zeros_like(p) for p in new_matrices]
+    opt.add_param_group({"params": [p for p in new_params if p.ndim != 2]})
+
