+def position_free(block, args):
+    """Forward pre-hook: identity rotation (cos 1, sin 0), so q.k ignores position in this block."""
+    x, cos, sin, *rest = args
+    return (x, torch.ones_like(cos), torch.zeros_like(sin), *rest)
