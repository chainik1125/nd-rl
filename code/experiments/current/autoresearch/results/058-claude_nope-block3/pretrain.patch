         if p.ndim == 2:
             # Orthogonal matrices have element second moment gain^2 / max(rows, cols).
             torch.nn.init.orthogonal_(p, gain=0.02 * math.sqrt(max(p.shape)))
+    # Registered on the returned model, so it stays active through the harness's RL and eval.
+    model.blocks[NOPE_LAYER].register_forward_pre_hook(position_free)
     log(
