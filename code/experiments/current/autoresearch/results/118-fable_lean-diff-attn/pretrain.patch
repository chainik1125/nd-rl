+class DiffAttnBlock(PeriLNBlock):
+    """Differential attention (Ye et al. 2024, DIFF Transformer) in the Peri-LN block: each head's
+    32-dim q and k are split into two 16-dim halves and the head's attention map becomes
+    softmax(q1 k1^T) - lambda * softmax(q2 k2^T) over the same 32-dim values, so common-mode
+    mass on distractor keys cancels. lambda = exp(lq1 . lk1) - exp(lq2 . lk2) + lambda_init per
+    block (lambda_init = 0.8 - 0.6 exp(-0.3 l), l the 0-indexed block), the head output gets a
+    headwise RMSNorm scaled by (1 - lambda_init), as in the paper. Same qkv/proj layers, head
+    count, KV cache and ALiBi/NoPE slope table as 115 (both halves of a head see its slope);
+    64 extra parameters per block."""
+
+    def __init__(self, d, h, layer):
+        super().__init__(d, h)
+        self.lam_init = 0.8 - 0.6 * math.exp(-0.3 * layer)
+        self.lam = torch.nn.Parameter(torch.randn(4 * (d // h // 2)) * 0.1)  # lq1, lk1, lq2, lk2
+
+    def attn(self, x, cos, sin, mask, cache):
+        B, T, D = x.shape
+        hd = D // self.h
+        q, k, v = self._qkv(x, cache)
+        q, k = q.view(B, self.h, T, 2, hd // 2), k.view(B, self.h, -1, 2, hd // 2)
+        bias = mask.to(q.dtype)
+        sdpa = torch.nn.functional.scaled_dot_product_attention  # default scale 1/sqrt(16)
+        lq1, lk1, lq2, lk2 = self.lam.view(4, -1)
+        lam = torch.exp(lq1 @ lk1) - torch.exp(lq2 @ lk2) + self.lam_init
+        y = sdpa(q[..., 0, :], k[..., 0, :], v, attn_mask=bias)
+        y = y - lam * sdpa(q[..., 1, :], k[..., 1, :], v, attn_mask=bias)
+        y = y * torch.rsqrt(y.float().square().mean(-1, keepdim=True) + 1e-6).to(y.dtype)
+        return self.proj((y * (1 - self.lam_init)).transpose(1, 2).reshape(B, T, D))
+
+
