+class CanonBlock(PeriLNBlock):
+    """Canon layers (Allen-Zhu 2025, Physics of LM 4.1): a causal depthwise convolution over
+    the last CANON_K residual states, x_t + sum_i w_i * x_{t-i}, before the attention (Canon-A)
+    and the MLP (Canon-C) of the Peri-LN block. PyTorch's default conv init, so it is random."""
+
+    def __init__(self, d, h):
+        super().__init__(d, h)
+        self.canon_a = torch.nn.Conv1d(d, d, CANON_K, groups=d, bias=False)
+        self.canon_c = torch.nn.Conv1d(d, d, CANON_K, groups=d, bias=False)
+
+    @staticmethod
+    def canon(conv, x, keep, cache, key):
+        """Left pads (keep False) read as zeros, like the start of a right-padded training row;
+        with a cache the previous CANON_K - 1 inputs of this canon layer come from it."""
+        B, T, D = x.shape
+        if keep is not None:
+            x = x * keep[:, :, None]
+        hist = cache[key] if cache is not None and key in cache else x.new_zeros(B, CANON_K - 1, D)
+        xs = torch.cat([hist, x], 1)
+        if cache is not None:
+            cache[key] = xs[:, -(CANON_K - 1) :]
+        return x + conv(xs.transpose(1, 2)).transpose(1, 2)
+
+    def forward(self, x, cos, sin, mask=None, cache=None):
+        keep = None if mask is None else mask[:, 0, -1, -x.size(1) :].to(x.dtype)
+        x = self.canon(self.canon_a, x, keep, cache, "canon_a")
+        x = x + self.ln_attn_out(self.attn(self.ln1(x), cos, sin, mask, cache))
+        x = self.canon(self.canon_c, x, keep, cache, "canon_c")
+        return x + self.ln_mlp_out(self.fc2(torch.nn.functional.gelu(self.fc1(self.ln2(x)))))
+
+
