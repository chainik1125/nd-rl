+def nonfinite_state(model: Any, row: dict[str, Any]) -> dict[str, Any] | None:
+    """--stop_nonfinite: what is non-finite after an iteration's update (the row's loss and grad
+    norms, the weights), None when nothing is."""
+    bad: dict[str, Any] = {
+        k: str(row[k])
+        for k in ("loss", "grad_norm", "grad_norm_max")
+        if k in row and not math.isfinite(row[k])
+    }
+    n = sum(1 for p in model.parameters() if not torch.isfinite(p).all())
+    if n:
+        bad["params_nonfinite"] = n
+    return bad or None
