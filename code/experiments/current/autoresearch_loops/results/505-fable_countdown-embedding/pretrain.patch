+def loop_probe(model, x, m, n=MAX_LOOPS):
+    """How the iteration moves at n loops on one batch (proof tokens only): the mean relative
+    change of the core state from each pass to the next, the mean norms of the entry output and
+    of the core state after the last pass, and the countdown rows' norms. A converged iteration
+    shows deltas falling to ~0 after a few passes; a used countdown shows row norms comparable
+    with the entry output's."""
+    was_training, n_loops, states = model.training, model.n_loops, []
+    model.eval()
+    model.n_loops = n
+    with torch.no_grad():
+        model.features(x, trace=states)
+    model.train(was_training)
+    model.n_loops = n_loops
+    e, core = states[0][m], [s[m] for s in states[1:]]
+    return {
+        "loops": n,
+        "pass_deltas": [
+            ((b - a).norm(dim=-1) / a.norm(dim=-1)).mean().item()
+            for a, b in zip(core, core[1:], strict=False)
+        ],
+        "entry_norm": e.norm(dim=-1).mean().item(),
+        "state_norm": core[-1].norm(dim=-1).mean().item(),
+        "countdown_norms": model.countdown.norm(dim=-1).tolist(),
+    }
