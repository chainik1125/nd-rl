  keywords = {Computer science,Electrical and electronic engineering},
  file = {/Users/dmitrymanning-coe/Zotero/storage/XEWITB88/Guo et al. - 2025 - DeepSeek-R1 incentivizes reasoning in LLMs through reinforcement learning.pdf}
}

